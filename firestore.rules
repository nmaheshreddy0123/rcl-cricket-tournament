rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidSlotId(teamId) {
      return teamId is string && teamId.matches('^slot-([1-9]|1[0-9]|2[0-4])$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        || (request.auth.token.email == 'nmaheshreddy0123@gmail.com' && request.auth.token.email_verified == true)
      );
    }

    function slotIsNext(slot) {
      return (!exists(/databases/$(database)/documents/registrationMeta/sequence) && slot == 1)
        || (exists(/databases/$(database)/documents/registrationMeta/sequence)
          && get(/databases/$(database)/documents/registrationMeta/sequence).data.nextSlot == slot);
    }

    function slotExistsAfter(slot) {
      return (slot == 1 && getAfter(/databases/$(database)/documents/teams/slot-1).data.slot == 1)
        || (slot == 2 && getAfter(/databases/$(database)/documents/teams/slot-2).data.slot == 2)
        || (slot == 3 && getAfter(/databases/$(database)/documents/teams/slot-3).data.slot == 3)
        || (slot == 4 && getAfter(/databases/$(database)/documents/teams/slot-4).data.slot == 4)
        || (slot == 5 && getAfter(/databases/$(database)/documents/teams/slot-5).data.slot == 5)
        || (slot == 6 && getAfter(/databases/$(database)/documents/teams/slot-6).data.slot == 6)
        || (slot == 7 && getAfter(/databases/$(database)/documents/teams/slot-7).data.slot == 7)
        || (slot == 8 && getAfter(/databases/$(database)/documents/teams/slot-8).data.slot == 8)
        || (slot == 9 && getAfter(/databases/$(database)/documents/teams/slot-9).data.slot == 9)
        || (slot == 10 && getAfter(/databases/$(database)/documents/teams/slot-10).data.slot == 10)
        || (slot == 11 && getAfter(/databases/$(database)/documents/teams/slot-11).data.slot == 11)
        || (slot == 12 && getAfter(/databases/$(database)/documents/teams/slot-12).data.slot == 12)
        || (slot == 13 && getAfter(/databases/$(database)/documents/teams/slot-13).data.slot == 13)
        || (slot == 14 && getAfter(/databases/$(database)/documents/teams/slot-14).data.slot == 14)
        || (slot == 15 && getAfter(/databases/$(database)/documents/teams/slot-15).data.slot == 15)
        || (slot == 16 && getAfter(/databases/$(database)/documents/teams/slot-16).data.slot == 16)
        || (slot == 17 && getAfter(/databases/$(database)/documents/teams/slot-17).data.slot == 17)
        || (slot == 18 && getAfter(/databases/$(database)/documents/teams/slot-18).data.slot == 18)
        || (slot == 19 && getAfter(/databases/$(database)/documents/teams/slot-19).data.slot == 19)
        || (slot == 20 && getAfter(/databases/$(database)/documents/teams/slot-20).data.slot == 20)
        || (slot == 21 && getAfter(/databases/$(database)/documents/teams/slot-21).data.slot == 21)
        || (slot == 22 && getAfter(/databases/$(database)/documents/teams/slot-22).data.slot == 22)
        || (slot == 23 && getAfter(/databases/$(database)/documents/teams/slot-23).data.slot == 23)
        || (slot == 24 && getAfter(/databases/$(database)/documents/teams/slot-24).data.slot == 24);
    }

    function slotMatchesId(teamId, slot) {
      return (slot == 1 && teamId == 'slot-1')
        || (slot == 2 && teamId == 'slot-2')
        || (slot == 3 && teamId == 'slot-3')
        || (slot == 4 && teamId == 'slot-4')
        || (slot == 5 && teamId == 'slot-5')
        || (slot == 6 && teamId == 'slot-6')
        || (slot == 7 && teamId == 'slot-7')
        || (slot == 8 && teamId == 'slot-8')
        || (slot == 9 && teamId == 'slot-9')
        || (slot == 10 && teamId == 'slot-10')
        || (slot == 11 && teamId == 'slot-11')
        || (slot == 12 && teamId == 'slot-12')
        || (slot == 13 && teamId == 'slot-13')
        || (slot == 14 && teamId == 'slot-14')
        || (slot == 15 && teamId == 'slot-15')
        || (slot == 16 && teamId == 'slot-16')
        || (slot == 17 && teamId == 'slot-17')
        || (slot == 18 && teamId == 'slot-18')
        || (slot == 19 && teamId == 'slot-19')
        || (slot == 20 && teamId == 'slot-20')
        || (slot == 21 && teamId == 'slot-21')
        || (slot == 22 && teamId == 'slot-22')
        || (slot == 23 && teamId == 'slot-23')
        || (slot == 24 && teamId == 'slot-24');
    }

    function isValidTeamSlot(data) {
      return data.keys().hasAll([
          'slot', 'teamName', 'teamNameKey', 'brandName', 'brandNameKey', 'logoUrl', 'captainName', 'registeredAt'
        ])
        && data.keys().hasOnly([
          'slot', 'teamName', 'teamNameKey', 'brandName', 'brandNameKey', 'logoUrl', 'captainName', 'registeredAt', 'updatedAt', 'paymentStatus', 'paymentScreenshotUrl'
        ])
        && data.slot is int
        && data.slot >= 1
        && data.slot <= 24
        && data.teamName is string
        && data.teamName.size() > 0
        && data.teamName.size() <= 60
        && isValidId(data.teamNameKey)
        && data.brandName is string
        && data.brandName.size() > 0
        && data.brandName.size() <= 60
        && isValidId(data.brandNameKey)
        && data.logoUrl is string
        && data.logoUrl.size() > 0
        && data.logoUrl.size() <= 65536
        && data.logoUrl.matches('^(https://.+|data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+)$')
        && data.captainName is string
        && data.captainName.size() > 0
        && data.captainName.size() <= 80
        && data.registeredAt is timestamp
        && (!('updatedAt' in data) || data.updatedAt is timestamp)
        && (!('paymentStatus' in data) || data.paymentStatus in ['pending', 'paid'])
        && (!('paymentScreenshotUrl' in data) || (
          data.paymentScreenshotUrl is string
          && data.paymentScreenshotUrl.size() <= 2048
          && data.paymentScreenshotUrl.matches('^https://firebasestorage\\.googleapis\\.com/v0/b/[^/]+/o/payment-screenshots%2Fslot-([1-9]|1[0-9]|2[0-4])%2F[A-Za-z0-9_-]+%2F[A-Za-z0-9_.-]+\\?alt=media&token=[A-Za-z0-9_-]+$')
        ));
    }

    function isValidUniqueKeyReservation(data) {
      return data.keys().hasAll(['teamId'])
        && data.keys().hasOnly(['teamId'])
        && isValidSlotId(data.teamId);
    }

    function isValidTeamRegistration(data, teamId) {
      return data.keys().hasAll(['teamId', 'captainName', 'captainPhone', 'ownerUid'])
        && data.keys().hasOnly(['teamId', 'captainName', 'captainPhone', 'ownerUid'])
        && data.teamId == teamId
        && isValidSlotId(data.teamId)
        && data.ownerUid is string
        && data.ownerUid.size() > 0
        && data.ownerUid.size() <= 128
        && data.captainName is string
        && data.captainName.size() > 0
        && data.captainName.size() <= 80
        && data.captainPhone is string
        && data.captainPhone.size() > 0
        && data.captainPhone.size() <= 25;
    }

    function isValidSequence(data) {
      return data.keys().hasAll(['nextSlot'])
        && data.keys().hasOnly(['nextSlot'])
        && data.nextSlot is int
        && data.nextSlot >= 2
        && data.nextSlot <= 25;
    }

    match /test/{docId} {
      allow get: if docId == 'connection';
    }

    match /teams/{teamId} {
      allow get: if isValidSlotId(teamId);
      allow list: if true;
      allow create: if isSignedIn()
        && isValidSlotId(teamId)
        && isValidTeamSlot(incoming())
        && !('updatedAt' in incoming())
        && 'paymentStatus' in incoming()
        && incoming().paymentStatus == 'pending'
        && incoming().registeredAt == request.time
        && slotMatchesId(teamId, incoming().slot)
        && slotIsNext(incoming().slot)
        && getAfter(/databases/$(database)/documents/registrationMeta/sequence).data.nextSlot == incoming().slot + 1
        && getAfter(/databases/$(database)/documents/teamNames/$(incoming().teamNameKey)).data.teamId == teamId
        && getAfter(/databases/$(database)/documents/teamBrands/$(incoming().brandNameKey)).data.teamId == teamId
        && getAfter(/databases/$(database)/documents/teamRegistrations/$(teamId)).data.teamId == teamId
        && getAfter(/databases/$(database)/documents/teamRegistrations/$(teamId)).data.ownerUid == request.auth.uid;
      allow update: if isSignedIn()
        && isValidSlotId(teamId)
        && isValidTeamSlot(incoming())
        && incoming().slot == existing().slot
        && incoming().registeredAt == existing().registeredAt
        && incoming().updatedAt is timestamp
        && incoming().updatedAt == request.time
        && (
          (
            isAdmin()
            && (
              (
                incoming().diff(existing()).affectedKeys().hasOnly(['paymentStatus', 'updatedAt'])
                && 'paymentStatus' in incoming()
                && incoming().paymentStatus in ['pending', 'paid']
              )
              || (
                incoming().diff(existing()).affectedKeys().hasOnly([
                  'teamName', 'teamNameKey', 'brandName', 'brandNameKey', 'logoUrl', 'captainName', 'updatedAt', 'paymentStatus'
                ])
                && (
                  (!('paymentStatus' in existing()) && 'paymentStatus' in incoming() && incoming().paymentStatus == 'pending')
                  || ('paymentStatus' in existing() && 'paymentStatus' in incoming() && incoming().paymentStatus in ['pending', 'paid'])
                )
                && (
                  incoming().teamNameKey == existing().teamNameKey
                  || (
                    !existsAfter(/databases/$(database)/documents/teamNames/$(existing().teamNameKey))
                    && getAfter(/databases/$(database)/documents/teamNames/$(incoming().teamNameKey)).data.teamId == teamId
                  )
                )
                && (
                  incoming().brandNameKey == existing().brandNameKey
                  || (
                    !existsAfter(/databases/$(database)/documents/teamBrands/$(existing().brandNameKey))
                    && getAfter(/databases/$(database)/documents/teamBrands/$(incoming().brandNameKey)).data.teamId == teamId
                  )
                )
                && getAfter(/databases/$(database)/documents/teamRegistrations/$(teamId)).data.captainName == incoming().captainName
              )
            )
          )
          || (
            ( !('paymentStatus' in existing()) || existing().paymentStatus == 'pending' )
            && incoming().paymentStatus == 'paid'
            && 'paymentScreenshotUrl' in incoming()
            && (
              !('paymentScreenshotUrl' in existing())
              || incoming().paymentScreenshotUrl != existing().paymentScreenshotUrl
            )
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'paymentStatus', 'paymentScreenshotUrl', 'updatedAt'
            ])
            && get(/databases/$(database)/documents/teamRegistrations/$(teamId)).data.ownerUid == request.auth.uid
          )
        );
      allow delete: if false;
    }

    match /teamNames/{nameKey} {
      allow get: if isSignedIn() && isValidId(nameKey);
      allow list: if false;
      allow create: if isSignedIn()
        && isValidId(nameKey)
        && isValidUniqueKeyReservation(incoming())
        && getAfter(/databases/$(database)/documents/teams/$(incoming().teamId)).data.teamNameKey == nameKey;
      allow delete: if isSignedIn()
        && isValidId(nameKey)
        && isValidSlotId(existing().teamId)
        && isAdmin()
        && getAfter(/databases/$(database)/documents/teams/$(existing().teamId)).data.teamNameKey != nameKey;
      allow update: if false;
    }

    match /teamBrands/{brandKey} {
      allow get: if isSignedIn() && isValidId(brandKey);
      allow list: if false;
      allow create: if isSignedIn()
        && isValidId(brandKey)
        && isValidUniqueKeyReservation(incoming())
        && getAfter(/databases/$(database)/documents/teams/$(incoming().teamId)).data.brandNameKey == brandKey;
      allow delete: if isSignedIn()
        && isValidId(brandKey)
        && isValidSlotId(existing().teamId)
        && isAdmin()
        && getAfter(/databases/$(database)/documents/teams/$(existing().teamId)).data.brandNameKey != brandKey;
      allow update: if false;
    }

    match /teamRegistrations/{teamId} {
      allow get: if isSignedIn()
        && isValidSlotId(teamId)
        && (existing().ownerUid == request.auth.uid || isAdmin());
      allow list: if isSignedIn()
        && (existing().ownerUid == request.auth.uid || isAdmin());
      allow create: if isSignedIn()
        && isValidSlotId(teamId)
        && isValidTeamRegistration(incoming(), teamId)
        && incoming().ownerUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/teams/$(teamId)).data.slot is int;
      allow update: if isSignedIn()
        && isValidSlotId(teamId)
        && isValidTeamRegistration(incoming(), teamId)
        && isAdmin()
        && incoming().diff(existing()).affectedKeys().hasOnly(['captainName', 'captainPhone'])
        && incoming().teamId == existing().teamId
        && incoming().ownerUid == existing().ownerUid
        && getAfter(/databases/$(database)/documents/teams/$(teamId)).data.captainName == incoming().captainName;
      allow delete: if false;
    }

    match /registrationMeta/{metaId} {
      allow get: if isSignedIn() && metaId == 'sequence';
      allow list: if false;
      allow create: if isSignedIn()
        && metaId == 'sequence'
        && isValidSequence(incoming())
        && incoming().nextSlot == 2
        && slotExistsAfter(1);
      allow update: if isSignedIn()
        && metaId == 'sequence'
        && isValidSequence(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly(['nextSlot'])
        && existing().nextSlot is int
        && existing().nextSlot >= 1
        && existing().nextSlot <= 24
        && incoming().nextSlot == existing().nextSlot + 1
        && slotExistsAfter(existing().nextSlot);
      allow delete: if false;
    }
  }
}
